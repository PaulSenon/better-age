{
	"name": "better-age",
	"private": true,
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PaulSenon/better-age.git"
	},
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"clean": "pnpm -r --if-present run clean",
		"clean:all": "pnpm run clean && rimraf node_modules .llms/references",
		"changeset": "changeset",
		"changeset:status": "changeset status --verbose",
		"changeset:version": "changeset version",
		"release:publish:next": "node tools/release/publish-packages.mjs --tag next",
		"release:build": "node tools/release/run-published-package-script.mjs build",
		"release:publish:stable": "node tools/release/publish-packages.mjs --tag latest",
		"release:version:prerelease": "node tools/release/derive-prerelease-version.mjs --channel next",
		"release:version:read": "node tools/release/read-release-version.mjs",
		"website:deploy:prod": "pnpm -F @infra/website run deploy:prod",
		"website:deploy:staging": "pnpm -F @infra/website run deploy:staging",
		"website:dev": "pnpm -F @infra/website run dev",
		"website:destroy:prod": "pnpm -F @infra/website run destroy:prod",
		"website:destroy:staging": "pnpm -F @infra/website run deploy:staging",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"format": "biome format --write .",
		"typecheck": "pnpm -r --if-present run typecheck",
		"test": "pnpm -r --if-present run test",
		"check": "pnpm -r --if-present run check && biome check .",
		"check:ci": "pnpm run check"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@changesets/changelog-github": "^0.6.0",
		"@changesets/cli": "^2.31.0",
		"rimraf": "catalog:",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.33.3+sha512.a19744364a7e248b92657a4ca5973f9354d21caf982579674b1c539f32c7420c47138ad8b1254df07aba9bc782d9b3029e3db34d5dbff974326eb74dac8ff489"
}
