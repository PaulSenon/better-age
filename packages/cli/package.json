{
	"name": "@better-age/cli",
	"version": "0.0.2",
	"type": "module",
	"bin": {
		"bage": "./dist/bage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PaulSenon/better-age.git",
		"directory": "packages/cli"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"pack": "pnpm pack --pack-destination ./dist",
		"build": "rimraf ./dist && node ./esbuild.config.mjs",
		"clean": "rimraf ./dist",
		"prepare": "effect-language-service patch",
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run lint && pnpm run typecheck",
		"test:unit": "vitest run -c vitest.unit.config.ts",
		"test": "pnpm run test:unit",
		"test:e2e": "node test/e2e/run.mjs"
	},
	"devDependencies": {
		"@better-age/core": "workspace:*",
		"@biomejs/biome": "2.4.10",
		"@effect/language-service": "0.87.2",
		"@effect/platform-node": "4.0.0-rc.117",
		"@effect/vitest": "4.0.0-rc.117",
		"@inquirer/prompts": "^8.4.2",
		"@types/node": "^25.6.0",
		"effect": "4.0.0-rc.117",
		"esbuild": "^0.28.0",
		"rimraf": "catalog:",
		"typescript": "^6.0.3",
		"vitest": "5.0.1"
	}
}
