{
	"name": "@better-age/core",
	"version": "0.0.2",
	"type": "module",
	"private": true,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PaulSenon/better-age.git",
		"directory": "packages/core"
	},
	"exports": {
		"./CoreLayer": "./src/CoreLayer.ts",
		"./Errors": "./src/Errors.ts",
		"./Home": "./src/Home.ts",
		"./Identities": "./src/Identities.ts",
		"./Notices": "./src/Notices.ts",
		"./Payloads": "./src/Payloads.ts",
		"./domain/Identity": "./src/domain/Identity.ts",
		"./domain/Payload": "./src/domain/Payload.ts",
		"./test-support/*": "./test/support/*.ts"
	},
	"scripts": {
		"lint": "biome check .",
		"lint:fix": "biome check . --write",
		"typecheck": "tsc --noEmit",
		"check": "pnpm run lint && pnpm run typecheck",
		"test:unit": "vitest run -c vitest.unit.config.ts",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"test": "pnpm run test:unit && pnpm run test:integration"
	},
	"dependencies": {
		"@noble/hashes": "2.0.1",
		"age-encryption": "^0.3.0",
		"effect": "4.0.0-rc.117"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@effect/language-service": "0.87.2",
		"@effect/platform-node": "4.0.0-rc.117",
		"@effect/vitest": "4.0.0-rc.117",
		"@types/node": "^25.6.0",
		"typescript": "^6.0.3",
		"vitest": "5.0.1"
	}
}
